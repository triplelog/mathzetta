{
  "name": "@mathzetta/cas",
  "version": "0.3.0",
  "description": "MathZetta CAS: exact computer algebra with explained steps — simplify, expand, factor, solve, differentiate, integrate, any-precision decimals, complex numbers — on a rule engine whose rules are readable YAML over MathZetta postfix.",
  "type": "module",
  "main": "src/cas/index.js",
  "types": "src/cas/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/cas/index.d.ts",
      "default": "./src/cas/index.js"
    },
    "./engine": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./yaml": {
      "types": "./src/yaml.d.ts",
      "default": "./src/yaml.js"
    },
    "./rules/*": "./rules/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "build:rules": "node tools/bundle-rules.mjs",
    "check:sympy": "node tools/check-sympy.mjs",
    "prepublishOnly": "npm test"
  },
  "files": [
    "src",
    "rules",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "devDependencies": {
    "mathzetta": "^1.3.0"
  },
  "homepage": "https://mathzetta.com/cas/",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triplelog/mathzetta.git",
    "directory": "packages/cas"
  },
  "author": {
    "name": "Robert Wilcox",
    "email": "rwilcox@mathzetta.com",
    "url": "https://mathzetta.com"
  },
  "bugs": {
    "url": "https://github.com/triplelog/mathzetta/issues",
    "email": "rwilcox@mathzetta.com"
  },
  "keywords": [
    "cas",
    "computer-algebra",
    "symbolic",
    "math",
    "simplify",
    "factor",
    "solve",
    "derivative",
    "integral",
    "steps",
    "rewrite-rules",
    "mathzetta"
  ],
  "engines": {
    "node": ">=18"
  }
}
